# PBC Visitor Kiosk — print-agent environment (EXAMPLE)
#
# Copy this file to `print-agent/.env` on the print server (Raspberry Pi).
# The real `.env` is git-ignored and MUST NOT be committed.

# Base URL of the backend API reachable from the print server.
PBC_API_BASE=http://your-backend-host:8000
# CUPS printer queue name on the print server.
PBC_PRINTER_NAME=QL800_BROTHER
# How often (seconds) the agent polls the backend for pending jobs.
PBC_PRINT_AGENT_POLL_SECONDS=3
# Per-job print timeout (seconds).
PBC_PRINT_TIMEOUT_SECONDS=60
# Local directory the agent uses to download badge images before printing.
PBC_PRINT_DOWNLOAD_DIR=./downloaded-badges
# Optional bearer token sent to the backend if set (leave blank if unused).
PBC_PRINT_AGENT_TOKEN=