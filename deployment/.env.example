# ============================================================================
# PBC Visitor Kiosk — container deployment configuration (EXAMPLE)
#
# Copy this file to `.env` in THIS directory and replace every placeholder:
#     cp .env.example .env         # macOS/Linux
#     Copy-Item .env.example .env  # Windows PowerShell
#
# `docker compose` reads this file automatically for BOTH:
#   * variable interpolation in the compose files (FRONTEND_PORT, etc.), and
#   * the backend container runtime environment (env_file: .env).
#
# The real `.env` is git-ignored and MUST NOT be committed.
# ============================================================================

# ----------------------------------------------------------------------------
# Compose / deployment settings
# ----------------------------------------------------------------------------
# Host port that publishes the frontend in the direct-access (no-Caddy) compose.
# The container always listens on 8080 internally.
FRONTEND_PORT=8080

# Tag applied to the built images.
IMAGE_TAG=latest

# Backend URL baked into the frontend at BUILD time. Leave EMPTY so the browser
# calls its own origin and nginx proxies /api, /uploads and /health to the
# backend. Only set this if the API is served from a different origin.
VITE_API_BASE=

# Public address Caddy serves (docker-compose.caddy.yml only):
#   :80                 -> HTTP only, any host (IP access, no TLS)
#   kiosk.example.org   -> automatic HTTPS via Let's Encrypt
CADDY_SITE_ADDRESS=:80

# ----------------------------------------------------------------------------
# Backend — Authentication (JWT)
# ----------------------------------------------------------------------------
# REQUIRED. Long, random signing key for session tokens (32+ characters).
# Changing this value invalidates all existing login sessions.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional (defaults shown).
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ----------------------------------------------------------------------------
# Backend — Initial administrator bootstrap (first run only)
# ----------------------------------------------------------------------------
# Used only to create the first administrator when none exists. The account is
# created with "must change password" enabled.
PBC_DEFAULT_ADMIN_USERNAME=admin
PBC_DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
PBC_DEFAULT_ADMIN_DISPLAY_NAME=Administrator

# ----------------------------------------------------------------------------
# Backend — Environment & CORS
# ----------------------------------------------------------------------------
# "production" is REQUIRED for a real deployment. In production the backend
# refuses to start unless PBC_CORS_ALLOWED_ORIGINS is non-empty.
PBC_ENV=production

# Comma-separated list of EXACT browser origins that serve the kiosk UI
# (scheme://host[:port], no trailing slash). Because the UI and API share one
# origin behind the proxy, list that public origin. Examples:
#   IP access:    http://192.168.0.210:8080
#   Caddy + TLS:  https://kiosk.example.org
PBC_CORS_ALLOWED_ORIGINS=http://localhost:8080

# ----------------------------------------------------------------------------
# Backend — Account lockout (brute-force protection)
# ----------------------------------------------------------------------------
PBC_LOGIN_LOCKOUT_THRESHOLD=5
PBC_LOGIN_LOCKOUT_MINUTES=15

# ----------------------------------------------------------------------------
# Backend — Upload / image limits
# ----------------------------------------------------------------------------
PBC_MAX_PHOTO_UPLOAD_BYTES=5242880
PBC_MAX_PHOTO_DIMENSION=1600
PBC_MAX_LOGO_UPLOAD_BYTES=2097152
PBC_MAX_LOGO_DIMENSION=512
PBC_MAX_IMAGE_PIXELS=24000000

# ----------------------------------------------------------------------------
# Backend — Badge rendering
# ----------------------------------------------------------------------------
PBC_BADGE_THEME=PBC_standard
