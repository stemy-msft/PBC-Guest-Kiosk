# PBC Visitor Kiosk — backend environment (EXAMPLE)
#
# Copy this file to `.env` in the repository root and replace every
# placeholder with a real value:
#
#     cp .env.example .env         # macOS/Linux
#     Copy-Item .env.example .env  # Windows PowerShell
#
# The real `.env` is git-ignored and MUST NOT be committed.

# --- Authentication (JWT) ---
# REQUIRED. Signing key for session tokens. Use a long, random secret.
# Recommend using a password manager to generate a 32+ character random string.
# Changing this value invalidates all existing login sessions.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional (defaults shown). Leave as-is unless you have a reason to change them.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Initial administrator bootstrap ---
# Used only to create the first administrator when none exists yet. The account
# is created with "must change password" enabled, so it must be changed at
# first login. These are optional; the defaults below are applied if unset.
PBC_DEFAULT_ADMIN_USERNAME=admin
PBC_DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
PBC_DEFAULT_ADMIN_DISPLAY_NAME=Administrator

# --- Account lockout (F-009) ---
# Brute-force protection for the login endpoint. Both are optional; the
# defaults below are applied if unset. Read once at startup.
#   THRESHOLD: consecutive failed logins before the account is locked.
#              Set to 0 to disable lockout entirely.
#   MINUTES:   how long the account stays locked before it auto-unlocks.
PBC_LOGIN_LOCKOUT_THRESHOLD=5
PBC_LOGIN_LOCKOUT_MINUTES=15

# --- CORS / cross-origin access (F-008) ---
# Controls which browser origins may call the API. Auth uses bearer tokens
# (no cookies), so credentialed CORS is intentionally disabled and the
# allowlist below never needs a wildcard.
#
#   PBC_ENV: "development" (default) or "production".
#     - development: if PBC_CORS_ALLOWED_ORIGINS is unset, safe localhost
#       defaults (http://localhost:5173, http://127.0.0.1:5173) are used.
#     - production: PBC_CORS_ALLOWED_ORIGINS is REQUIRED. The backend refuses
#       to start if it is empty.
#
#   PBC_CORS_ALLOWED_ORIGINS: comma-separated list of exact origins
#     (scheme://host[:port], no trailing slash or path). List every browser
#     origin that serves the kiosk/admin UI. If the UI and API are same-origin
#     behind a reverse proxy, no entry is needed for that path.
#
# Example production value:
#   PBC_ENV=production
#   PBC_CORS_ALLOWED_ORIGINS=https://kiosk.example.org,https://admin.example.org
PBC_ENV=development
PBC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173